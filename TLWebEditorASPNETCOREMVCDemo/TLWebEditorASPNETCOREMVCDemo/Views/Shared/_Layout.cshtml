        const rightPanelOptions = {
            properties: `
                                                                <div id="propGrid" class="table-wrapper-scroll-y my-custom-scrollbar tab-pane active">
                                                                </div>
                                                                `,
            datasource: `
                                                                <h4>Sample in XML format</h4>

                                                                <div class="alert alert-warning alert-dismissible" role="alert">
                                                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                                                        <span aria-hidden="true">&times;</span>
                                                                    </button>
                                                                    <i class="fa fa-warning"></i> <strong>NOTE</strong>
                                                                    <p class="small margin-bottom-none" style="margin-top: 5px;">
                                                                        This data source is fixed for this demo (for simplicity only) but you're free to fit it to your own scenario with another one.
                                                                    </p>
                                                                </div>

                                                                <div class="well well-sm" style="background-color: #d9edf7; border-color: #bce8f1; color: #31708f;">
                                                                    <form style="margin-bottom: 0;">
                                                                        <div class="checkbox" style="margin-top: 0; margin-bottom: 0;">
                                                                            <label>
                                                                                <input type="checkbox" id="chkUseDataSourceSample" name="chkUseDataSourceSample">
                                                                                <strong>Use this Data Source for the current label...</strong>
                                                                            </label>
