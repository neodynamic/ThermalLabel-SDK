                                                            <p class="text-muted" style="font-size: 12px; margin-bottom: 15px;">Most common 2D barcodes:</p>


                                                            <div class="text-preset-list">
                                                                <div class="text-preset-item" data-type="body" onclick="UIEditor.addNewItem('Barcode2D', ['QRCode','ABC123'])">
