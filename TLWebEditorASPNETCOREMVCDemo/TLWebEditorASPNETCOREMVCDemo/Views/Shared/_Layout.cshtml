        $(document).ready(function () {
            const $leftPanel = $('#left-panel');
            const $leftPanelBody = $('#left-panel-dynamic-body');
            const $leftPanelTitle = $('#left-panel-title');

            // Set left panel default view on load
            $leftPanelBody.html(leftPanelOptions['templates']);

            const $rightPanel = $('#right-panel');
            const $rightPanelBody = $('#right-panel-dynamic-body');
            const $rightPanelTitle = $('#right-panel-title');

            // Set right panel default view on load
            $rightPanelBody.html(rightPanelOptions['properties']);

            // Sidebar tools click event (Toggle and Swap content logic)
            $('.tool-item').click(function () {
                const targetKey = $(this).data('target');

                const targetPanel = (targetKey == 'properties' || targetKey == 'datasource' || targetKey == 'expressions' || targetKey == 'outline') ? 'r' : 'l';

                const isAlreadyActive = $(this).hasClass('active');
                const isDrawerCollapsed = targetPanel == 'l' ? $leftPanel.hasClass('collapsed') : $rightPanel.hasClass('collapsed');

                if (isAlreadyActive) {
                    // Scenario A: Clicked the same active button -> Collapse the panel
                    if (targetPanel == 'l')
                        $leftPanel.addClass('collapsed');
                    else
                        $rightPanel.addClass('collapsed');

                    $(this).removeClass('active');
                } else {
                    // Scenario B: Clicked a different button -> Switch content & Ensure it's visible
                    $('.tool-item').removeClass('active');
                    $(this).addClass('active');

                    // Update contents
                    if (targetPanel == 'l') {
                        $leftPanelTitle.text($(this).text().trim());
                        $leftPanelBody.html(leftPanelOptions[targetKey]);

                        if (targetKey == 'templates')
                            gallery.displayAllLabels();
                        if (targetKey == 'images') {
                            $('#uploadBtn').on('click', function () {
                                $('#fileInput').trigger('click');
                            });

                            $('#fileInput').on('change', function (event) {
                                var file = event.target.files[0];

                                if (!file) return;

                                var validTypes = ['image/jpeg', 'image/png', 'image/jpg'];
                                if ($.inArray(file.type, validTypes) === -1) {
                                    alert('Please select JPG or PNG only.');
                                    $('#fileInput').val('');
                                    return;
                                }

                                var reader = new FileReader();
                                reader.onload = function (e) {
                                    var imageSrc = e.target.result;

                                    bufferUploadedImages.push(imageSrc);

                                    showUploadedImages();
                                };

                                reader.readAsDataURL(file);

                                $('#fileInput').val('');
                            });

                            // load cached images
                            showUploadedImages();
                            // load preset symbols
                            showSymbolImages();
                        }

                    } else {
                        $rightPanelTitle.text($(this).text().replace('ƒx', '').trim());
                        $rightPanelBody.html(rightPanelOptions[targetKey]);

                        if (targetKey == 'datasource') // load sample data source
                            $('#txtDataSource').val("<?xml version=\"1.0\"?><catalog><book id=\"bk101\"><author>Gambardella, Matthew</author><title>XML Developer's Guide</title > <genre>Computer</genre><price>44.95</price><publish_date>2000-10-01</publish_date><description>An in-depth look at creating applications with XML.</description></book > <book id=\"bk102\"><author>Ralls, Kim</author><title>Midnight Rain</title><genre>Fantasy</genre><price>5.95</price><publish_date>2000-12-16</publish_date><description>A former architect battles corporate zombies, an evil sorceress, and her own childhood to become queen of the world.</description></book><book id=\"bk103\"><author>Corets, Eva</author><title>Maeve Ascendant</title><genre>Fantasy</genre><price>5.95</price><publish_date>2000-11-17</publish_date><description>After the collapse of a nanotechnology society in England, the young survivors lay the foundation for a new society.</description></book><book id=\"bk104\"><author>Corets, Eva</author><title>Oberon's Legacy</title><genre>Fantasy</genre><price>5.95</price><publish_date>2001-03-10</publish_date><description>In post-apocalypse England, the mysterious agent known only as Oberon helps to create a new life for the inhabitants of London. Sequel to Maeve Ascendant.</description></book><book id=\"bk105\"><author>Corets, Eva</author><title>The Sundered Grail</title><genre>Fantasy</genre><price>5.95</price><publish_date>2001-09-10</publish_date><description>The two daughters of Maeve, half-sisters, battle one another for control of England. Sequel to Oberon's Legacy.</description></book><book id=\"bk106\"><author>Randall, Cynthia</author><title>Lover Birds</title><genre>Romance</genre><price>4.95</price><publish_date>2000-09-02</publish_date><description>When Carla meets Paul at an ornithology conference, tempers fly as feathers get ruffled.</description></book><book id=\"bk107\"><author>Thurman, Paula</author><title>Splish Splash</title><genre>Romance</genre><price>4.95</price><publish_date>2000-11-02</publish_date><description>A deep sea diver finds true love twenty thousand leagues beneath the sea.</description></book><book id=\"bk108\"><author>Knorr, Stefan</author><title>Creepy Crawlies</title><genre>Horror</genre><price>4.95</price><publish_date>2000-12-06</publish_date><description>An anthology of horror stories about roaches,centipedes, scorpions  and other insects.</description></book><book id=\"bk109\"><author>Kress, Peter</author><title>Paradox Lost</title><genre>Science Fiction</genre><price>6.95</price><publish_date>2000-11-02</publish_date><description>After an inadvertant trip through a HeisenbergUncertainty Device, James Salway discovers the problems of being quantum.</description></book><book id=\"bk110\"><author>O'Brien, Tim</author><title>Microsoft .NET: The Programming Bible</title><genre>Computer</genre><price>36.95</price><publish_date>2000-12-09</publish_date><description>Microsoft's .NET initiative is explored in detail in this deep programmer's reference.</description></book><book id=\"bk111\"><author>O'Brien, Tim</author><title>MSXML3: A Comprehensive Guide</title><genre>Computer</genre><price>36.95</price><publish_date>2000-12-01</publish_date><description>The Microsoft MSXML3 parser is covered in detail, with attention to XML DOM interfaces, XSLT processing, SAX and more.</description></book><book id=\"bk112\"><author>Galos, Mike</author><title>Visual Studio 7: A Comprehensive Guide</title><genre>Computer</genre><price>49.95</price><publish_date>2001-04-16</publish_date><description>Microsoft Visual Studio 7 is explored in depth,looking at how Visual Basic, Visual C++, C#, and ASP+ are integrated into a comprehensive development environment.</description></book></catalog>");
                        else if (targetKey == 'expressions') // load current label's global expressions
                            UIEditor.displayGlobalExpressions();
                        else if (targetKey == 'properties') // load label's properties
                            tleditor.selectionChanged();
                        else if (targetKey == 'outline') // build the document outline
                            DocumentOutline.render();
                    }

                    // Slide drawer open if it was hidden
                    if (isDrawerCollapsed) {
                        if (targetPanel == 'l')
                            $leftPanel.removeClass('collapsed');
                        else
                            $rightPanel.removeClass('collapsed');
                    }
                }
            });

            // Chevron left button event -> Manually hide panel and remove highlights
            $('#btn-close-drawer-left').click(function () {
                $leftPanel.addClass('collapsed');
                $('.tool-item').removeClass('active');
            });

            // Chevron right button event -> Manually hide panel and remove highlights
            $('#btn-close-drawer-right').click(function () {
                $rightPanel.addClass('collapsed');
                $('.tool-item').removeClass('active');
            });

            // Triggering Modals
            $('#btn-new').click(function (e) { e.preventDefault(); LabelDocDialog.open('new'); });
            $('#btn-label-props').click(function (e) { e.preventDefault(); LabelDocDialog.open('edit'); });
            $('#btn-open').click(function (e) { e.preventDefault(); $('#open-document').modal('show'); });
            $('#btn-preview').click(function (e) { e.preventDefault(); UIEditor.showLabelPreview(); $('#preview-dialog').modal('show'); });
            $('#btn-print').click(function (e) { e.preventDefault(); $('#print-dialog').modal('show'); });
            $('#btn-options').click(function (e) { e.preventDefault(); UIEditor.getOptions(); $('#options').modal('show'); });
            $('#btn-shortcuts').click(function (e) { e.preventDefault(); $('#shortcuts').modal('show'); });

            // Buffer for uploaded images by the user
            var bufferUploadedImages = [];
            function showUploadedImages() {
                var $container = $('#gridImages');

                $container.empty();

                $.each(bufferUploadedImages, function (index, base64Image) {

                    var backColor = '#e8e8ec';
                    var $col = $('<div>').addClass('col-xs-6');

                    var $gridItem = $('<div>')
                        .addClass('grid-item')
                        .css({
                            'background-color': backColor,
                            'height': '100px',
                            'padding': '5px',
                            'box-sizing': 'border-box',
                            'position': 'relative'
                        })
                        .on('click', function () {
                            UIEditor.addNewItem('Image', bufferUploadedImages[index]);
                        });

                    var $deleteBtn = $('<span>')
                        .html('<i class="fa fa-times"></i>')
                        .css({
                            'position': 'absolute',
                            'top': '5px',
                            'right': '5px',
                            'color': '#fff',
                            'background-color': 'rgba(217, 83, 79, 0.9)',
                            'padding': '3px 7px',
                            'border-radius': '20%',
                            'cursor': 'pointer',
                            'font-size': '10px',
                            'z-index': '10',
                            'transition': 'background-color 0.2s'
                        })
                        .hover(
                            function () { $(this).css('background-color', '#c9302c'); },
                            function () { $(this).css('background-color', 'rgba(217, 83, 79, 0.9)'); }
                        )
                        .on('click', function (e) {
                            e.stopPropagation();
                            bufferUploadedImages.splice(index, 1);
                            showUploadedImages();
                        });

                    var $img = $('<img>').attr('src', base64Image).css({
                        'width': '100%',
                        'height': '100%',
                        'object-fit': 'contain',
                        'display': 'block',
                        'margin': '0 auto'
                    });

                    $gridItem.append($deleteBtn);
                    $gridItem.append($img);
                    $col.append($gridItem);
                    $container.append($col);
                });
            }

            // Show preset of symbol images
            function showSymbolImages() {
                var $container = $('#symbolImages');

                $container.empty();

                $.each(packagingSymbols, function (index, symb) {

                    var backColor = '#e8e8ec';
                    var $col = $('<div>').addClass('col-xs-3');

                    var $gridItem = $('<div>')
                        .addClass('grid-item')
                        .css({
                            'background-color': backColor,
                            'height': '50px',
                            'padding': '5px',
                            'box-sizing': 'border-box'
                        })
                        .on('click', function () {
                            UIEditor.addNewItem('Image', symb.base64);
                        });

                    var $img = $('<img>').attr('src', symb.base64).attr('title', symb.name).css({
                        'width': '100%',
                        'height': '100%',
                        'object-fit': 'contain',
                        'display': 'block',
                        'margin': '0 auto'
                    });

                    $gridItem.append($img);
                    $col.append($gridItem);
                    $container.append($col);
                });
            }

            // user session timeout
            function endSession() {
                $('#sessionExpired').modal('show');
            }
            setTimeout(endSession, 900000); //15 min

            var os = (function () {
                var ua = navigator.userAgent.toLowerCase();
                return {
                    isWindows: /(windows|win32|win64)/.test(ua),
                    isLinux: /(linux)/.test(ua),
                    isIntelMac: /(intel mac)/.test(ua),
                    isAndroid: /(android)/.test(ua)
                };
            }());

            if (os.isLinux || os.isIntelMac || os.isAndroid) {
                $('#btn-print').hide();
            }

        });


    </script>


    @RenderSection("Scripts", required: false)
</body>
</html>
