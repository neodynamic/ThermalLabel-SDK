                                                            <div class="text-preset-list">
                                                                <div class="text-preset-item" data-type="body" onclick="UIEditor.addNewItem('RFID', ['ASCII','ABC123'])">
                                                                    <div class="text-preset-body"><i class="fa fa-rss"></i> ASCII Data</div>
                                                                </div>
                                                                <div class="text-preset-item" data-type="body" onclick="UIEditor.addNewItem('RFID', ['Hexadecimal','4D792044617461'])">
                                                                    <div class="text-preset-body"><i class="fa fa-rss"></i> Hexadecimal Data</div>
                                                                </div>
                                                                <div class="text-preset-item" data-type="body" onclick="UIEditor.addNewItem('RFID', ['EPC','16,3,5,78742,146165,1234567891','96,8,3,3,20,24,38'])">
                                                                    <div class="text-preset-body"><i class="fa fa-rss"></i> EPC Data</div>
                                                                </div>
                                                                <div class="text-preset-item" data-type="body" onclick="UIEditor.addNewItem('RFID', ['Hexadecimal','11223344','EPCClass1Gen2', 4, 3, '1'])">
                                                                    <div class="text-preset-body"><i class="fa fa-rss"></i> Hexadecimal Data - EPC Class-1 Gen-2</div>
                                                                </div>
                                                            </div>
                                                            `,
            misc: `
                                                            <div class="row">
                                                                <div class="col-xs-4 tb-item">
                                                                    <button id="tlbRepeater" type="button" title="Repeater" class="btn btn-default" onclick="UIEditor.addNewItem('Repeater')"
                                                                            data-content="Add Repeater" data-trigger="hover" data-placement="bottom">
                                                                        <img src="images/icons/Repeater.png" />
                                                                    </button>
                                                                    <small>Repeater</small>
                                                                </div>
                                                                <div class="col-xs-4 tb-item">
                                                                    <button id="tlbLiteral" type="button" title="Literal" class="btn btn-default" onclick="UIEditor.addNewItem('Literal')"
                                                                            data-content="Add Literal" data-trigger="hover" data-placement="bottom">
                                                                        <img src="images/icons/literal.png" />
