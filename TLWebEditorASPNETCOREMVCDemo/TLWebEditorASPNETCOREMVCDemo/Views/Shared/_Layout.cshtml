                                                            <h4>Symbols</h4>
                                                            <div id="symbolImages" class="row"></div>
                                                            `,
            shapes: `
                                                            <div class="row">
                                                                <div class="col-xs-4 tb-item" >
                                                                    <button id="tlbRect" type="button" title="Rectangle" class="btn btn-default" onclick="UIEditor.addNewItem('Rectangle')"
                                                                            data-content="Add Rectangle" data-trigger="hover" data-placement="bottom" style="display: block; margin: 0 auto 5px auto;">
                                                                        <img src="images/icons/rect.png" />
                                                                    </button>
