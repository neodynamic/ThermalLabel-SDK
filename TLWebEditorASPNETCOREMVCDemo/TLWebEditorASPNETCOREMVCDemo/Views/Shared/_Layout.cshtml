                                                                            data-content="Add Rectangle" data-trigger="hover" data-placement="bottom">
                                                                        <img src="images/icons/table.png" />
                                                                    </button>
                                                                    <small>Table</small>
                                                                </div>
                                                            </div>`,
            rfid: `
                                                            <div class="row">
                                                                <div class="col-xs-4 tb-item">
                                                                    <button id="tlbRFID" type="button" title="RFID Tag" class="btn btn-default" onclick="UIEditor.addNewItem('RFID')"
                                                                            data-content="Add RFID" data-trigger="hover" data-placement="bottom">
                                                                        <img src="images/icons/RFIDTag.png" />
                                                                    </button>
                                                                    <small>RFID Tag</small>
                                                                </div>
                                                            </div>

                                                            <hr/>
                                                            <h4 class="tb-item-title-icon">
                                                                <img src="images/icons/RFIDTag.png" />
