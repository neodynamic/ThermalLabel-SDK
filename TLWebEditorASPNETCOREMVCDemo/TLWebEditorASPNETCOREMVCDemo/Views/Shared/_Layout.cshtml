                                                                    <div class="text-preset-body"><i class="fa fa-qrcode"></i> Data Matrix</div>
                                                                </div>
                                                                <div class="text-preset-item" data-type="body" onclick="UIEditor.addNewItem('Barcode2D', ['Pdf417','ABC123'])">
                                                                    <div class="text-preset-body"><i class="fa fa-qrcode"></i> PDF417</div>
                                                                </div>
                                                                <div class="text-preset-item" data-type="body" onclick="UIEditor.addNewItem('Barcode2D', ['MaxiCode','ABC123456789', 'Mode4'])">
                                                                    <div class="text-preset-body"><i class="fa fa-qrcode"></i> Maxicode</div>
                                                                </div>
                                                                <div class="text-preset-item" data-type="body" onclick="UIEditor.addNewItem('Barcode2D', ['GS1QRCode','(01)95012345678903'])">
                                                                    <div class="text-preset-body"><i class="fa fa-qrcode"></i> GS1 QR Code</div>
