                                                                </div>
                                                                <div class="text-preset-item" data-type="body" onclick="UIEditor.addNewItem('Barcode', ['UpcA','01234567890'])">
                                                                    <div class="text-preset-body"><i class="fa fa-barcode"></i> UPC-A</div>
                                                                </div>
                                                                <div class="text-preset-item" data-type="body" onclick="UIEditor.addNewItem('Barcode', ['Ean13','501234567890'])">
