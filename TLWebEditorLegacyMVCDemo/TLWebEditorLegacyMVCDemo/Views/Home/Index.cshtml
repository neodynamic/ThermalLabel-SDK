</nav>

<!-- Main Workspace Container -->
<div class="main-container">

    <!-- Left Vertical Icon Sidebar -->
    <div class="sidebar-tools">
        <div class="tool-item active" data-target="templates">
            <i class="fa fa-th-large"></i> Templates
        </div>
        <div class="tool-item" data-target="text">
            <i class="fa fa-font"></i> Text
        </div>
        <div class="tool-item" data-target="barcode">
            <i class="fa fa-barcode"></i> Barcode
        </div>
        <div class="tool-item" data-target="images">
            <i class="fa fa-image"></i> Images
        </div>
        <div class="tool-item" data-target="shapes">
            <i class="fa fa-pencil"></i> Shapes
        </div>
        <div class="tool-item" data-target="rfid">
            <i class="fa fa-rss"></i> RFID
        </div>
        <div class="tool-item" data-target="misc">
            <i class="fa fa-wrench"></i> Misc
        </div>
    </div>

    <!-- Sliding Component Options Drawer -->
    <div class="sidebar-content" id="left-panel">
        <div class="panel-header">
            <h4 id="left-panel-title">Templates</h4>
            <button class="btn-close-drawer" id="btn-close-drawer-left" title="Hide Panel">
                <i class="fa fa-chevron-left"></i>
            </button>
        </div>

        <!-- Dynamic Drawer Container Panels -->
        <div id="left-panel-dynamic-body">
            <!-- Content injected via jQuery -->
        </div>
    </div>

    <!-- Central Workspace Core Container -->
    <div class="workspace">
        <!-- ================= FIXED TOP OPERATIONS TOOLBAR ================= -->
        <div class="workspace-navbar">
            <!-- Operations on Active Items & Selection Targets -->
            <div class="pull-left">
                <!-- History: Undo & Redo -->
                <div class="btn-group" role="group">
                    <button type="button" class="btn" id="btn-undo" title="Undo (Ctrl+Z)" onclick="UIEditor.undo()">
                        <i class="fa fa-undo"></i>
                    </button>
                    <button type="button" class="btn" id="btn-redo" title="Redo (Ctrl+Y)" onclick="UIEditor.redo()">
                        <i class="fa fa-repeat"></i>
                    </button>
                </div>

                <span class="toolbar-separator"></span>

                <!-- Clipboard: Cut, Copy & Paste -->
                <div class="btn-group" role="group">
                    <button type="button" class="btn" id="btn-cut" title="Cut (Ctrl+X)" onclick="UIEditor.clipboardCut()">
                        <i class="fa fa-scissors"></i>
                    </button>
                    <button type="button" class="btn" id="btn-copy" title="Copy (Ctrl+C)" onclick="UIEditor.clipboardCopy()">
                        <i class="fa fa-files-o"></i>
                    </button>
                    <button type="button" class="btn" id="btn-paste" title="Paste (Ctrl+V)" onclick="UIEditor.clipboardPaste()">
                        <i class="fa fa-clipboard"></i>
                    </button>
                </div>

                <span class="toolbar-separator"></span>

                <!-- Depth / Layer Arrangement Order Actions -->
                <div class="btn-group" role="group">
                    <button type="button" class="btn" id="btn-bring-to-front" title="Bring to Front" onclick="UIEditor.bringToFront()">
                        <i class="fa fa-angle-double-up"></i>
                    </button>
                    <button type="button" class="btn" id="btn-bring-forward" title="Bring Forward" onclick="UIEditor.bringForward()">
                        <i class="fa fa-angle-up"></i>
                    </button>
                    <button type="button" class="btn" id="btn-send-backward" title="Send Backward" onclick="UIEditor.sendBackward()">
                        <i class="fa fa-angle-down"></i>
                    </button>
                    <button type="button" class="btn" id="btn-send-to-back" title="Send to Back" onclick="UIEditor.sendToBack()">
                        <i class="fa fa-angle-double-down"></i>
                    </button>
                </div>

                <span class="toolbar-separator"></span>
                <!-- Layout Options Dropdown -->
                <div class="btn-group">
                    <button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" title="Layout and Alignment">
                        <i class="fa fa-align-left"></i> <span class="caret"></span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-left" style="min-width: 210px; padding: 8px;">
                        <!-- Alignment Section -->
                        <li class="dropdown-header" style="padding: 3px 6px;">Alignment</li>
                        <li style="margin-bottom: 8px;">
                            <div class="btn-group btn-group-justified" role="group">
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-default btn-sm" title="Align Left" onclick="UIEditor.alignItems('Left')">
                                        <i class="fa fa-align-left"></i>
                                    </button>
                                </div>
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-default btn-sm" title="Center Horizontally" onclick="UIEditor.alignItems('CenterHorizontal')">
                                        <i class="fa fa-bars fa-rotate-90"></i>
                                    </button>
                                </div>
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-default btn-sm" title="Align Right" onclick="UIEditor.alignItems('Right')">
                                        <i class="fa fa-align-right"></i>
                                    </button>
                                </div>
                            </div>
                        </li>
                        <li style="margin-bottom: 8px;">
                            <div class="btn-group btn-group-justified" role="group">
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-default btn-sm" title="Align Top" onclick="UIEditor.alignItems('Top')">
                                        <i class="fa fa-minus" style="vertical-align: top; border-top: 2px solid; width: 12px; height: 10px;"></i>
                                    </button>
                                </div>
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-default btn-sm" title="Center Vertically" onclick="UIEditor.alignItems('CenterVertical')">
                                        <i class="fa fa-bars"></i>
                                    </button>
                                </div>
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-default btn-sm" title="Align Bottom" onclick="UIEditor.alignItems('Bottom')">
                                        <i class="fa fa-minus" style="vertical-align: bottom; border-bottom: 2px solid; width: 12px; height: 10px;"></i>
                                    </button>
                                </div>
                            </div>
                        </li>

                        <li class="divider" role="separator"></li>

                        <!-- Distribution Section -->
                        <li class="dropdown-header" style="padding: 3px 6px;">Distribution</li>
                        <li style="margin-bottom: 8px;">
                            <div class="btn-group btn-group-justified" role="group">
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-default btn-sm" title="Distribute Horizontally" onclick="UIEditor.alignItems('DistributeHorizontal')">
                                        <i class="fa fa-arrows-h"></i>
                                    </button>
                                </div>
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-default btn-sm" title="Distribute Vertically" onclick="UIEditor.alignItems('DistributeVertical')">
                                        <i class="fa fa-arrows-v"></i>
                                    </button>
                                </div>
                            </div>
                        </li>

                        <li class="divider" role="separator"></li>

                        <!-- Match Size Section -->
                        <li class="dropdown-header" style="padding: 3px 6px;">Match Size</li>
                        <li>
                            <div class="btn-group btn-group-justified" role="group">
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-default btn-sm" title="Same Width" onclick="UIEditor.setSelectedItemsToSameSize(true, false)">
                                        <i class="fa fa-arrows-h" style="border-left: 1px solid; border-right: 1px solid; padding: 0 2px;"></i>
                                    </button>
                                </div>
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-default btn-sm" title="Same Height" onclick="UIEditor.setSelectedItemsToSameSize(false, true)">
                                        <i class="fa fa-arrows-v" style="border-top: 1px solid; border-bottom: 1px solid; padding: 2px 0;"></i>
                                    </button>
                                </div>
                            </div>
                        </li>
                    </ul>
                </div>


                <span class="toolbar-separator"></span>

                <!-- General Utility Item Operations -->
                <div class="btn-group" role="group">
                    <button type="button" class="btn" id="btn-duplicate" title="Duplicate Item" onclick="UIEditor.objectDuplicate()">
                        <i class="fa fa-clone"></i>
                    </button>
                    <button type="button" class="btn" id="btn-lock" title="Lock Item" onclick="UIEditor.lockItem()">
                        <i class="fa fa-lock"></i>
                    </button>
                    <button type="button" class="btn" id="btn-unlock" title="Unlock Item" onclick="UIEditor.unlockItem()">
                        <i class="fa fa-unlock-alt"></i>
                    </button>
                    <button type="button" class="btn" id="btn-delete" style="color: #ff5c5c;" title="Delete Item" onclick="UIEditor.deleteSelectedItems()">
                        <i class="fa fa-trash-o"></i>
                    </button>
                </div>

                <span class="toolbar-separator"></span>

                <!-- Group Actions -->
                <div class="btn-group" role="group" aria-label="Group actions">
                    <button id="tlbStartGroup" type="button" title="Start a new group" class="btn btn-default" onclick="UIEditor.startGroup()" data-content="Start a new group" data-trigger="hover" data-placement="bottom">
                        <i class="fa fa-object-group" aria-hidden="true"></i>
                    </button>
                    <button id="tlbGroupSelectedItems" type="button" title="Num of selected items in the group" class="btn btn-default" style="display:none" onclick="" data-content="Num of selected items in the group" data-trigger="hover" data-placement="bottom" disabled>
                        <i class="fa fa-tags" aria-hidden="true"></i> <span class="badge">0</span>
                    </button>
                    <button id="tlbCreateGroup" type="button" style="color: #00acf8; display: none" title="Create and close group" class="btn btn-info" onclick="UIEditor.createGroup()" data-content="Create and close group" data-trigger="hover" data-placement="bottom">
                        <i class="fa fa-check" aria-hidden="true"></i>
                    </button>
                    <button id="tlbCancelGroup" type="button" style="color: #ff5c5c; display: none" title="Cancel group creation" class="btn btn-danger" onclick="UIEditor.cancelGroup()" data-content="Cancel group creation" data-trigger="hover" data-placement="bottom">
                        <i class="fa fa-times" aria-hidden="true"></i>
                    </button>
                    <button id="tlbUngroup" type="button" title="Ungroup" class="btn btn-danger" style="display: none" onclick="UIEditor.unGroup()" data-content="Ungroup" data-trigger="hover" data-placement="bottom">
                        <i class="fa fa-object-ungroup" aria-hidden="true"></i>
                    </button>
                </div>

            </div>

            <!-- Zoom & View Engine Viewport Controls -->
            <div class="pull-right">
                <div class="btn-group" role="group">
                    <button type="button" class="btn" id="btn-zoom-out" title="Zoom Out" onclick="UIEditor.changeZoom('-')">
                        <i class="fa fa-search-minus"></i>
                    </button>
                    <button type="button" class="btn" style="width: 55px; pointer-events: none;" id="zoom-val">
                        100%
                    </button>
                    <button type="button" class="btn" id="btn-zoom-in" title="Zoom In" onclick="UIEditor.changeZoom('+')">
                        <i class="fa fa-search-plus"></i>
                    </button>
                    <button type="button" class="btn" id="btn-zoom-reset" title="Reset Zoom" onclick="UIEditor.changeZoom('1')">
                        Reset
                    </button>
                </div>
                <span class="toolbar-separator"></span>

                <!-- Dropdown: Rotate View -->
                <div class="btn-group">
                    <button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" title="Rotate View">
                        <i class="fa fa-eye"></i> <span class="caret"></span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-right" style="min-width: 140px;">
                        <li>
                            <a href="javascript:void(0);" onclick="UIEditor.rotateView('None', this)">
                                <span class="rotate-check-wrapper" style="display:inline-block; width:20px;"><i class="fa fa-check text-success dynamic-check"></i></span>
                                <i class="fa fa-file-picture-o fa-fw"></i> 0° (Normal)
                            </a>
                        </li>
                        <li>
                            <a href="javascript:void(0);" onclick="UIEditor.rotateView('Degree90', this)">
                                <span class="rotate-check-wrapper" style="display:inline-block; width:20px;"><i class="fa fa-check text-success dynamic-check hidden"></i></span>
                                <i class="fa fa-file-picture-o fa-rotate-90 fa-fw"></i> 90° CW
                            </a>
                        </li>
                        <li>
                            <a href="javascript:void(0);" onclick="UIEditor.rotateView('Degree180', this)">
                                <span class="rotate-check-wrapper" style="display:inline-block; width:20px;"><i class="fa fa-check text-success dynamic-check hidden"></i></span>
                                <i class="fa fa-file-picture-o fa-rotate-180 fa-fw"></i> 180°
                            </a>
                        </li>
                        <li>
                            <a href="javascript:void(0);" onclick="UIEditor.rotateView('Degree270', this)">
                                <span class="rotate-check-wrapper" style="display:inline-block; width:20px;"><i class="fa fa-check text-success dynamic-check hidden"></i></span>
                                <i class="fa fa-file-picture-o fa-rotate-270 fa-fw"></i> 270° CW
                            </a>
                        </li>
                    </ul>
                </div>

            </div>
        </div>

        <!-- Canvas Viewport Inner Section -->
        <div class="canvas-viewport">
            <!-- ThermalLabel Web Editor Canvas container -->
            <div id="tle-container"></div>
        </div>
    </div>


    <!-- ================= 4. NEW: Right Sidebar (Layers & Settings) ================= -->
    <div class="sidebar-right" id="right-panel">

        <div class="panel-header">
            <h4 id="right-panel-title">Properties</h4>
            <button class="btn-close-drawer" id="btn-close-drawer-right" title="Hide Panel">
                <i class="fa fa-chevron-right"></i>
            </button>
        </div>

        <!-- Dynamic Drawer Container Panels -->
        <div id="right-panel-dynamic-body">
            <!-- Content injected via jQuery -->
        </div>


    </div>

    <!-- Right Vertical Icon Sidebar -->
    <div class="sidebar-right-tools">
        <div class="tool-item active" data-target="properties">
            <i class="fa fa-sliders"></i> Properties
        </div>
        <div class="tool-item" data-target="datasource">
            <i class="fa fa-database"></i> Data Source
        </div>
        <div class="tool-item" data-target="expressions">
            <span class="fx-circle"><span class="fx-text">ƒx</span></span> Expressions
        </div>
        <div class="tool-item" data-target="outline">
            <i class="fa fa-list-ul"></i> Document Outline
        </div>
    </div>

</div>

<!-- ================= APP OVERLAY DIALOGS (MODALS) ================= -->

<div class="modal fade modal-studio" id="error-dialog" tabindex="-1" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><i class="glyphicon glyphicon-exclamation-sign" style="color:firebrick"></i> Error</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12">
                        <p id="error-msg"></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>

            </div>
        </div>
    </div>
</div>

<div class="modal fade modal-studio" id="shortcuts" tabindex="-1" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"><i class="fa fa-keyboard-o"></i> Keyboard Shortcuts</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th>Shortcut</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>TextItem enter in edit mode</td>
                                    <td><strong>F2</strong></td>
                                </tr>
                                <tr>
                                    <td>TextItem quit edit mode</td>
                                    <td><strong>Esc</strong></td>
                                </tr>
                                <tr>
                                    <td>Undo</td>
                                    <td><strong>Ctrl + Z</strong></td>
                                </tr>
                                <tr>
                                    <td>Redo</td>
                                    <td><strong>Ctrl + Y</strong></td>
                                </tr>
                                <tr>
                                    <td>Cut</td>
                                    <td><strong>Ctrl + X</strong> or <strong>Shift + Del</strong></td>
                                </tr>
                                <tr>
                                    <td>Copy</td>
                                    <td><strong>Ctrl + C</strong> or <strong>Ctrl + Insert</strong></td>
                                </tr>
                                <tr>
                                    <td>Paste</td>
                                    <td><strong>Ctrl + V</strong> or <strong>Shift + Insert</strong></td>
                                </tr>
                                <tr>
                                    <td>Delete/Remove Selected Item</td>
                                    <td><strong>Del</strong></td>
                                </tr>
                                <tr>
                                    <td>Move Selected Item</td>
                                    <td><strong>Arrow Keys</strong> or <strong>Ctrl + Arrow Keys</strong> for large steps</td>
                                </tr>

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>

            </div>
        </div>
    </div>
</div>

<div id="label-document" class="modal fade modal-studio" tabindex="-1" role="dialog" aria-labelledby="ld_title_text">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">&times;</button>
                <h4 class="modal-title"><i id="ld_title_icon" class="fa fa-file-o"></i> <span id="ld_title_text">New Label</span></h4>
            </div>
            <div class="modal-body">

                <!-- Layout type -->
                <div id="ld_layouts" class="ld-layouts" role="radiogroup" aria-label="Label layout">
                    <button type="button" class="ld-layout" role="radio" data-layout="single"><i class="fa fa-square-o"></i>Roll &ndash; single labels</button>
                    <button type="button" class="ld-layout" role="radio" data-layout="multicolumn"><i class="fa fa-columns"></i>Roll &ndash; multicolumn</button>
                    <button type="button" class="ld-layout" role="radio" data-layout="sheet"><i class="fa fa-th"></i>Sheet labels</button>
                    <button type="button" class="ld-layout" role="radio" data-layout="pages"><i class="fa fa-files-o"></i>Multi pages</button>
                    <button type="button" class="ld-layout" role="radio" data-layout="duplex"><i class="fa fa-clone"></i>Duplex label</button>
                </div>

                <div class="ld-body">
                    <div class="ld-diagram">
                        <img id="ld_diagram" src="images/labeldoc/roll-single.png" alt="Diagram of the selected label layout and its measurements" />
                    </div>

                    <div class="ld-settings">
                        <fieldset class="ld-group" data-group="general">
                            <legend>General</legend>
                            <div class="ld-field">
                                <label for="ld_unit">Unit</label>
                                <select id="ld_unit" class="form-control"></select>
                            </div>
                        </fieldset>

                        <fieldset class="ld-group" data-group="label">
                            <legend>Label <span class="ld-unit-suffix"></span></legend>
                            <div class="ld-grid">
                                <div class="ld-field">
                                    <label for="ld_width" id="ld_label_width_caption">Width</label>
                                    <input id="ld_width" type="number" step="any" min="0" class="form-control" />
                                </div>
                                <div class="ld-field">
                                    <label for="ld_height">Height</label>
                                    <input id="ld_height" type="number" step="any" min="0" class="form-control" />
                                </div>
                            </div>
                            <div class="ld-grid">
                                <div class="ld-field">
                                    <label for="ld_shape">Shape</label>
                                    <select id="ld_shape" class="form-control"></select>
                                </div>
                            </div>
                        </fieldset>

                        <fieldset class="ld-group" data-group="margin">
                            <legend>Margin <span class="ld-unit-suffix"></span></legend>
                            <div class="ld-grid ld-grid-4">
                                <div class="ld-field">
                                    <label for="ld_margin_left">Left</label>
                                    <input id="ld_margin_left" type="number" step="any" min="0" class="form-control" />
                                </div>
                                <div class="ld-field">
                                    <label for="ld_margin_top">Top</label>
                                    <input id="ld_margin_top" type="number" step="any" min="0" class="form-control" />
                                </div>
                                <div class="ld-field">
                                    <label for="ld_margin_right">Right</label>
                                    <input id="ld_margin_right" type="number" step="any" min="0" class="form-control" />
                                </div>
                                <div class="ld-field">
                                    <label for="ld_margin_bottom">Bottom</label>
                                    <input id="ld_margin_bottom" type="number" step="any" min="0" class="form-control" />
                                </div>
                            </div>
                        </fieldset>

                        <fieldset class="ld-group" data-group="sheet">
                            <legend>Sheet <span class="ld-unit-suffix"></span></legend>
                            <div class="ld-grid">
                                <div class="ld-field">
                                    <label for="ld_sheet_width">Width</label>
                                    <input id="ld_sheet_width" type="number" step="any" min="0" class="form-control" />
                                </div>
                                <div class="ld-field">
                                    <label for="ld_sheet_height">Height</label>
                                    <input id="ld_sheet_height" type="number" step="any" min="0" class="form-control" />
                                </div>
                                <div class="ld-field">
                                    <label for="ld_sheet_margin_left">Margin left</label>
                                    <input id="ld_sheet_margin_left" type="number" step="any" min="0" class="form-control" />
                                </div>
                                <div class="ld-field">
                                    <label for="ld_sheet_margin_top">Margin top</label>
                                    <input id="ld_sheet_margin_top" type="number" step="any" min="0" class="form-control" />
                                </div>
                                <div class="ld-field">
                                    <label for="ld_sheet_labels_count">Labels per sheet</label>
                                    <input id="ld_sheet_labels_count" type="number" step="1" min="0" class="form-control" />
                                </div>
                            </div>
                        </fieldset>

                        <fieldset class="ld-group" data-group="vlayout">
                            <legend>Vertical layout <span class="ld-unit-suffix"></span></legend>
                            <div class="ld-checks">
                                <label><input type="checkbox" id="ld_is_continuous" />Continuous media</label>
                            </div>
                            <div class="ld-grid">
                                <div class="ld-field">
                                    <label for="ld_gap_length">Gap length</label>
                                    <input id="ld_gap_length" type="number" step="any" min="0" class="form-control" />
                                </div>
                                <div class="ld-field">
                                    <label for="ld_mark_length">Mark length</label>
                                    <input id="ld_mark_length" type="number" step="any" min="0" class="form-control" />
                                </div>
                            </div>
                        </fieldset>

                        <fieldset class="ld-group" data-group="hlayout">
                            <legend>Horizontal layout</legend>
                            <div class="ld-grid">
                                <div class="ld-field">
                                    <label for="ld_hgap_length">Gap length <span class="ld-unit-suffix"></span></label>
                                    <input id="ld_hgap_length" type="number" step="any" min="0" class="form-control" />
                                </div>
                                <div class="ld-field">
                                    <label for="ld_labels_per_row">Labels per row</label>
                                    <input id="ld_labels_per_row" type="number" step="1" min="1" class="form-control" />
                                </div>
                            </div>
                        </fieldset>

                        <fieldset class="ld-group" data-group="pages">
                            <legend>Pages <span class="ld-unit-suffix"></span></legend>
                            <table id="ld_pages" class="table table-condensed ld-pages">
                                <thead>
                                    <tr><th>X</th><th>Y</th><th>Width</th><th>Height</th><th></th></tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                            <p id="ld_pages_empty" class="ld-pages-empty">No pages yet. Add one to define its position and size.</p>
                            <button type="button" id="ld_pages_add" class="btn btn-default btn-sm"><i class="fa fa-plus"></i> Add page</button>
                        </fieldset>

                        <fieldset class="ld-group" data-group="print">
                            <legend>Print options</legend>
                            <div class="ld-checks">
                                <label><input type="checkbox" id="ld_print_mirror" />Print as mirror</label>
                                <label><input type="checkbox" id="ld_cut_after_printing" />Cut after printing</label>
                            </div>
                            <div class="ld-grid">
                                <div class="ld-field">
                                    <label for="ld_print_speed">Print speed</label>
                                    <input id="ld_print_speed" type="text" class="form-control" />
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>

                <div id="ld_errors" class="alert alert-danger ld-errors" role="alert" style="display:none"></div>
            </div>
            <div class="modal-footer">
                <div class="ld-footer-left">
                    <button type="button" id="ld_backimg_set" class="btn btn-default"><i class="fa fa-picture-o"></i> Set design background&hellip;</button>
                    <img id="ld_backimg_thumb" class="ld-backimg-thumb" alt="Design background image" style="display:none" />
                    <button type="button" id="ld_backimg_clear" class="btn btn-link" style="display:none">Clear background</button>
                    <input type="file" id="ld_backimg_file" accept=".png,image/png" style="display:none" />
                </div>
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" id="ld_ok" class="btn btn-primary">Create label</button>
            </div>
        </div>
    </div>
</div>

