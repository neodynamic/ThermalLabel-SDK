            <li><a href="#" id="btn-new"><i class="fa fa-file-o"></i> New</a></li>
            <li><a href="#" id="btn-open"><i class="fa fa-folder-open-o"></i> Open</a></li>
            <li><a href="#" id="btn-label-props"><i class="fa fa-tag"></i> Label Properties</a></li>
            <li class="dropdown">
                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
