                        </a>
                    </li>
                </ul>
            </li>
            <li class="dropdown">
                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                    <i class="fa fa-share-square-o"></i> Export <span class="caret"></span>
                </a>
                <ul class="dropdown-menu" style="z-index:5000">
                    <li>
                        <a href="#" onclick="UIEditor.exportDocument('Pdf')">
                            <i class="fa fa-file-pdf-o" aria-hidden="true"></i> PDF
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="UIEditor.exportDocument('Jpeg')">
                            <i class="fa fa-file-image-o" aria-hidden="true"></i> JPEG
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="UIEditor.exportDocument('Png')">
                            <i class="fa fa-file-image-o" aria-hidden="true"></i> PNG
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="UIEditor.exportDocument('Svg')">
                            <i class="fa fa-file-code-o" aria-hidden="true"></i> SVG
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="UIEditor.exportDocument('Html')">
